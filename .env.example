# 복사해서 .env로 쓴다. 이 파일에는 실제 비밀값을 넣지 않는다.
# 필수: APP_ENV, DATABASE_URL, ADMIN_USERNAME, ADMIN_PASSWORD_HASH, TOKEN_ENCRYPTION_KEY
# 나머지 외부 연동 값은 비어 있어도 앱이 뜨고, 설정 화면에서 "연결 안 됨"으로 보인다.

APP_ENV=development            # development | test | production
PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info

DATABASE_URL=postgres://xauto:xauto@127.0.0.1:5432/xauto?sslmode=disable

ADMIN_USERNAME=admin
# go run ./cmd/admin hash-password 로 만든 Argon2id 해시. 평문 비밀번호를 넣지 않는다
ADMIN_PASSWORD_HASH=
# go run ./cmd/admin gen-key 로 한 번 만들고 계속 같은 값을 쓴다 (재배포마다 바꾸면 저장된 토큰을 못 읽는다)
TOKEN_ENCRYPTION_KEY=
SESSION_TTL=720h

# 실제 X 게시 차단 스위치. 처음에는 false
PUBLISHING_ENABLED=false
# live | mock — mock이면 X·AI·R2 모두 테스트 대역을 쓰고 화면에 "목업"으로 표시
INTEGRATION_MODE=mock

AI_API_KEY=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/api/x/oauth/callback

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=x-automation/
R2_PUBLIC_BASE_URL=
