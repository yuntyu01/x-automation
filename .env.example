# 복사해서 .env로 쓴다. 이 파일에는 실제 비밀값을 넣지 않는다.
# 필수: APP_ENV, DATABASE_URL, ADMIN_USERNAME, ADMIN_PASSWORD_HASH, TOKEN_ENCRYPTION_KEY
# 나머지 외부 연동 값은 비어 있어도 앱이 뜨고, 설정 화면에서 "연결 안 됨"으로 보인다.

APP_ENV=development            # development | test | production
PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info
# 앞단 프록시가 있으면 그 대역만 X-Forwarded-For를 믿는다 (예: 10.0.0.0/8). 비우면 접속 주소만 쓴다
TRUSTED_PROXY_CIDRS=
# 목업 저장소 등 개발용 로컬 파일 위치
DATA_DIR=.data

DATABASE_URL=postgres://xauto:xauto@127.0.0.1:5432/xauto?sslmode=disable
# DATABASE_URL 대신 DB_HOST·DB_PORT·DB_NAME·DB_USER·DB_PASSWORD(·DB_SSLMODE)로도 연결할 수 있다 (KoDeploy 관리형 DB)
# 시작할 때 마이그레이션을 자동 적용한다 (잠금 사용). false면 `go run ./cmd/admin migrate`로 직접 적용
MIGRATE_ON_START=true

ADMIN_USERNAME=admin
# go run ./cmd/admin hash-password 로 만든 Argon2id 해시. 평문 비밀번호를 넣지 않는다
# 이 파일은 셸로 읽으므로 $가 사라지지 않게 작은따옴표로 감싼다: ADMIN_PASSWORD_HASH='$argon2id$v=19$...'
# (KoDeploy 환경변수 화면에는 따옴표 없이 그대로 넣는다)
ADMIN_PASSWORD_HASH=
# go run ./cmd/admin gen-key 로 한 번 만들고 계속 같은 값을 쓴다 (재배포마다 바꾸면 저장된 토큰을 못 읽는다)
TOKEN_ENCRYPTION_KEY=
SESSION_TTL=720h

# 실제 X 게시 차단 스위치. 처음에는 false
PUBLISHING_ENABLED=false
# live | mock — mock이면 X·AI·R2 모두 테스트 대역을 쓰고 화면에 "목업"으로 표시
INTEGRATION_MODE=mock

AI_API_KEY=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=
# OpenAI 호환 주소를 바꿀 때만 (기본 https://api.openai.com/v1)
AI_BASE_URL=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/api/x/oauth/callback
# 테스트용 가짜 X 서버를 쓸 때만 바꾼다 (운영은 비워 두면 공식 주소)
X_API_BASE_URL=
X_AUTHORIZE_URL=
X_TOKEN_URL=

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=x-automation/
R2_PUBLIC_BASE_URL=
# R2_* 가 비어 있고 S3_BUCKET이 있으면 KoDeploy가 주입한 S3_ENDPOINT·S3_ACCESS_KEY·S3_SECRET_KEY·S3_BUCKET·S3_PUBLIC_BASE_URL을 쓴다
